## MediaServer configuration
##
## Copy/rename this file to ".env" on the Raspberry Pi.
## Media root points at the VAULT drive where Videos/Movies/etc live.

# Port the server will listen on
PORT=4000

# Single mount point (or comma-separated list of mount points)
MEDIA_ROOTS=/media/davids11971/VAULT

# Top-level folders expected under each MEDIA_ROOT (comma-separated)
MEDIA_FOLDERS=Photos,Videos,Movies,TVShows,Documents

# Optional: thumbnail cache directory (default: ./thumbcache)
THUMB_CACHE_DIR=/home/pi/MediaServer/thumbcache

# Optional: max chunk size (bytes) used when client requests Range streaming
VIDEO_CHUNK_SIZE=1048576


