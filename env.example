## MediaServer configuration
##
## Copy/rename this file to ".env" on the Raspberry Pi.
## Media root points at the VAULT drive where Videos/Movies/etc live.

# Port the server will listen on
PORT=4000

# Network interface to bind to.
# Use 0.0.0.0 to allow other devices on your LAN to connect.
HOST=0.0.0.0

# =========================
# Debug / logging knobs
# =========================
# error|warn|info|debug|trace
LOG_LEVEL=info

# 1 = log every request/response (recommended while debugging)
LOG_REQUESTS=1

# 1 = include full request headers (Authorization/Cookie are redacted)
LOG_REQUEST_HEADERS=0

# 1 = include response headers
LOG_RESPONSE_HEADERS=0

# 1 = log scanning activity (useful if /api/media is slow or empty)
LOG_SCAN=0

# 1 = log path resolution / traversal blocks (useful for 400/404 issues)
LOG_RESOLVE=0

# 1 = log CORS origin checks
LOG_CORS=0

# 1 = verbose logs for /stream requests (range, size, etc)
LOG_STREAM=0

# 1 = verbose logs for thumbnails (cache hit/miss, sharp errors)
LOG_THUMBS=0

# 1 = enable /debug/config and /debug/routes endpoints (do NOT leave on if exposed to internet)
DEBUG_ENDPOINTS=0

# Optional request timeout in ms (0 = disabled). Helpful to surface hung requests.
# REQUEST_TIMEOUT_MS=15000

# Single mount point (or comma-separated list of mount points)
MEDIA_ROOTS=/media/davids11971/VAULT

# Top-level folders expected under each MEDIA_ROOT (comma-separated)
MEDIA_FOLDERS=Photos,Videos,Movies,TVShows,Documents

# Optional: thumbnail cache directory (default: ./thumbcache)
# TIP: keep this path writable by the user running node (relative paths are fine).
# THUMB_CACHE_DIR=./thumbcache

# Optional: max chunk size (bytes) used when client requests Range streaming
# VIDEO_CHUNK_SIZE=1048576


