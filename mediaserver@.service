[Unit]
Description=Family Media Server (%i)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=%i
WorkingDirectory=/home/%i/stewart_media_server
Environment=HOME=/home/%i
ExecStart=/home/%i/stewart_media_server/scripts/systemd-entrypoint.sh
Restart=always
RestartSec=3

# Default env (override in .env)
Environment=NODE_ENV=production
Environment=HOST=0.0.0.0
Environment=LOG_LEVEL=info
Environment=LOG_REQUESTS=1

# Load your .env if present
EnvironmentFile=-/home/%i/stewart_media_server/.env

[Install]
WantedBy=multi-user.target


